# RPC Nodes
DATABASE_URL=postgres://user:password@localhost:5432/dbname

# Subgraph
SUBGRAPH_KEY=
NON_RESTRICTED_SUBGRAPH_KEY=

# AWS Cache
AWS_ACCESS_KEY_ID=
AWS_REGION=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_ENDPOINT=

# RPC memory cache: off (default), shadow (fill and compare, always ask the node) or on
RPC_CACHE=
RPC_CACHE_MB=512
RPC_CACHE_DEPTH=32

# Optional
SENTRY_DSN=
SENTRY_TRACE_SAMPLE_RATE=

# Partner Keys (optional)
STORY_PARTNER_KEY=
STORY_PARTNER_KEY_TESTNET=
