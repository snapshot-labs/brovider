{
  "name": "brovider",
  "version": "0.1.0",
  "license": "MIT",
  "scripts": {
    "lint": "eslint src/ tests/ --ext .ts",
    "lint:fix": "bun run lint --fix",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "dev": "bun --watch src/index.ts",
    "start": "node dist/src/index.js",
    "test": "bun test --preload ./tests/preload.ts --timeout 10000"
  },
  "eslintConfig": {
    "extends": "@snapshot-labs"
  },
  "prettier": "@snapshot-labs/prettier-config",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.842.0",
    "@snapshot-labs/snapshot-metrics": "^1.4.2",
    "@snapshot-labs/snapshot-sentry": "^3.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^5.1.0",
    "express-http-proxy": "^1.6.3",
    "graphql": "^16.11.0",
    "node-fetch": "^2.7.0",
    "pg-promise": "^11.14.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@snapshot-labs/eslint-config": "^0.1.0-beta.17",
    "@snapshot-labs/prettier-config": "^0.1.0-beta.7",
    "@types/bun": "^1.3.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/node": "^20.4.8",
    "@types/node-fetch": "^2.6.11",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/parser": "^2.33.0",
    "eslint": "^8.28.0",
    "eslint-plugin-prettier": "^3.1.3",
    "prettier": "^2.7.1",
    "supertest": "^7.1.1"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "packageManager": "bun@1.4.0",
  "patchedDependencies": {
    "express-http-proxy@1.6.3": "patches/express-http-proxy@1.6.3.patch"
  }
}
